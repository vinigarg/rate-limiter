{
  "rules": [
    {
      "id": "billing-api",
      "priority": 100,
      "match": { "path_prefix": "/v1/billing/" },
      "key_by": ["tenant"],
      "strategy": "sliding_window_counter",
      "scope": "global",
      "on_error": "fail_closed",
      "limits": [ { "limit": 600, "window": "1m" } ]
    },
    {
      "id": "public-api",
      "priority": 50,
      "match": { "path_prefix": "/v1/" },
      "key_by": ["api_key"],
      "strategy": "token_bucket",
      "scope": "hybrid",
      "on_error": "fail_local",
      "fallback_scale": 0.1,
      "lease_size": 100,
      "lease_ttl": "1s",
      "limits": [ { "limit": 10000, "window": "1m", "burst": 1000 } ]
    },
    {
      "id": "per-ip-backstop",
      "priority": 1,
      "key_by": ["ip"],
      "strategy": "gcra",
      "limits": [ { "limit": 1000, "window": "1s", "burst": 2000 } ]
    }
  ]
}
